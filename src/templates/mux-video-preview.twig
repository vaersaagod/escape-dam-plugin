{% js 'https://cdn.jsdelivr.net/npm/@mux/mux-player@3.14.0/dist/mux-player.js' with {
    integrity: 'sha384-RjbgI7s9y7fLrFpckJIrG2S3LWPybGAEJh+do/hy1U7gYBAx7thBxmw0Qq+h9HM8',
    crossorigin: 'anonymous',
} %}

<mux-player
        stream-type="on-demand"
        playback-id="{{ video.getMuxPlaybackId() }}"
        metadata-video-title="{{ video.title }}"
        style="width:100%;height:100%;"
        autoplay="true"
></mux-player>
